# 5G Network Slice Performance Monitor — Environment Variables
# Copy this file to .env and fill in your values.

# Flask secret key (auto-generated if not set)
SECRET_KEY=

# Session cookie path (default: /)
SESSION_COOKIE_PATH=/

# Gunicorn workers
WEB_CONCURRENCY=2

# Data directory
DATA_DIR=/app/data

# Kindo AI Agent configuration
# See agent/agents/slice-performance.yaml for agent setup instructions
KINDO_API_KEY=
KINDO_SLICE_PERFORMANCE_AGENT_ID=
